# Copier ce fichier en .env et remplir les valeurs
# Le fichier .env ne doit PAS être commité (voir .gitignore)

# ---------------------------------------------------------------------------
# Modèle LLM
# ---------------------------------------------------------------------------
# Fournisseur : openrouter (par défaut), mistral, groq, ollama ou custom.
# Le projet utilise le format d'API « compatible OpenAI » : changer de fournisseur
# ne demande que de modifier ces lignes.
LLM_PROVIDER=openrouter

# OpenRouter : créer un compte et une clé sur https://openrouter.ai/settings/keys
# Les modèles « :free » sont gratuits, sans carte bancaire. Sans crédit acheté, rien
# ne peut être facturé : au-delà de la limite quotidienne, l'API refuse la requête (429).
OPENROUTER_API_KEY=

# Modèle (facultatif). La liste des modèles gratuits évolue :
# https://openrouter.ai/models?q=free
# LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
# Modèles de secours si le premier est saturé (séparés par des virgules)
# LLM_FALLBACK_MODELS=inclusionai/ling-3.2-flash:free,google/gemma-4-31b-it:free

# Mistral : LLM_PROVIDER=mistral et MISTRAL_API_KEY=...
# Groq : LLM_PROVIDER=groq et GROQ_API_KEY=...
# Ollama (modèle local, sans clé) : LLM_PROVIDER=ollama et LLM_MODEL=<modèle installé>
# Autre fournisseur compatible OpenAI :
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://.../v1
# LLM_API_KEY=...
# LLM_MODEL=...

# Débit maximal en requêtes par seconde (OpenRouter gratuit : 0.3, soit 18 par minute)
# LLM_REQUESTS_PER_SECOND=1

# Appels LLM simultanés maximum
# LLM_MAX_CONCURRENCY=3

# Effort de raisonnement des modèles gpt-oss : low (économe), medium, high
# LLM_REASONING_EFFORT=low

# ---------------------------------------------------------------------------
# APIs externes
# ---------------------------------------------------------------------------
# GitHub token (optionnel) — sans token : 60 req/h, avec : 5 000 req/h
# Créer gratuitement sur https://github.com/settings/tokens (scope: aucun requis)
GITHUB_TOKEN=

# Stack Overflow key (optionnel) — sans clé : 300 req/jour, avec : 10 000 req/jour
# Créer gratuitement sur https://stackapps.com/apps/oauth/register
STACKOVERFLOW_KEY=

# ---------------------------------------------------------------------------
# RAG / Mémoire vectorielle
# ---------------------------------------------------------------------------
# Dossier de persistance ChromaDB (créé automatiquement)
# CHROMADB_DIR=./data/chromadb

# Base SQLite des runs API (historique UI/API)
# RUNS_DB_PATH=./data/runs.sqlite

# ---------------------------------------------------------------------------
# Seuils de scoring (optionnel — valeurs par défaut déjà raisonnables)
# ---------------------------------------------------------------------------
# SCORE_SEUIL_CONTACT=75
# SCORE_SEUIL_VIABLE=40
# TOP_N_RELATIF=3
# MAX_PROFILS_RECHERCHE=15
# Candidats évalués par recherche (10 par défaut ; baisser si le quota gratuit du jour s'épuise trop vite)
# MAX_PROFILS_PARALLELES=10
